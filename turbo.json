{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["tsconfig.json", ".oxlintrc.json"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["NEXT_PUBLIC_*"]
    },
    "dev": { "cache": false, "persistent": true },
    "lint": { "outputs": [] },
    "format": { "outputs": [] },
    "typecheck": { "dependsOn": ["^build"], "outputs": ["*.tsbuildinfo"] },
    "test": { "outputs": [] },
    "test:coverage": { "outputs": ["coverage/**"] },
    "clean": { "cache": false }
  }
}
