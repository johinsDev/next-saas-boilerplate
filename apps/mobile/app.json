{
  "expo": {
    "name": "SaaS Boilerplate",
    "slug": "saas-boilerplate",
    "scheme": "saasboilerplate",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.example.saasboilerplate" },
    "android": { "package": "com.example.saasboilerplate", "edgeToEdgeEnabled": true },
    "web": { "bundler": "metro", "output": "static" },
    "plugins": ["expo-router"],
    "experiments": { "typedRoutes": true }
  }
}
