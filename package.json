{
  "name": "next-saas-boilerplate",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.2.10",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/tooling/*",
    "partykit"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "format": "turbo run format",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "knip": "knip",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "db:generate": "bun run --cwd packages/db db:generate",
    "db:migrate": "bun run --cwd packages/db db:migrate",
    "db:seed:owner": "bun run --cwd packages/db db:seed:owner",
    "db:seed:demo": "bun run --cwd packages/db db:seed:demo",
    "db:studio": "bun run --cwd packages/db db:studio",
    "prepare": "lefthook install || true",
    "jobs:dev": "bun run --cwd packages/jobs trigger:dev",
    "jobs:deploy": "bun run --cwd packages/jobs trigger:deploy"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@commitlint/types": "^19.8.1",
    "@types/bun": "^1.3.14",
    "knip": "^5.88.1",
    "lefthook": "^1.13.6",
    "oxlint": "^0.15.15",
    "turbo": "^2.10.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.2"
  }
}
